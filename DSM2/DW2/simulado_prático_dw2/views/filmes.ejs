<%- include ('partials/header.ejs') %>

    <div class="container">
        <h1>Cadastrar novo filme:</h1>
        <form action="/filmes/cadastrar" method="POST">
            <label>Título:</label>
            <input type="text" name="titulo">
            <label>Gênero:</label>
            <input type="text" name="genero">
            <label>Duração:</label>
            <input type="text" name="duracao">
            <input type="submit" value="Cadastrar">
        </form>
        <br><hr><br>
        <table>
            <thead>
                <th style="width: 150px; text-align: left;">Título:</th>
                <th style="width: 200px; text-align: left;">Gênero:</th>
                <th style="width: 150px; text-align: left;">Duração:</th>
                <th style="width: 150px; text-align: left;">Ações:</th>
            </thead>
            <tbody>
                <!-- Aqui vai o forEach -->
                <% filmes.forEach(filme => {%>
                    <tr>
                        <td><%= filme.titulo %></td>
                        <td><%= filme.genero %></td>
                        <td><%= filme.duracao %></td>
                        <td>
                            <a onclick="return confirm('Deseja mesmo excluir o filme?')" href="/filmes/excluir/<%= filme.id%>">Deletar</a>
                        </td>
                    </tr>
                <% }) %>
                <!-- Fim do forEach -->
            </tbody>
        </table>
    </div>

<%- include ('partials/footer.ejs') %>
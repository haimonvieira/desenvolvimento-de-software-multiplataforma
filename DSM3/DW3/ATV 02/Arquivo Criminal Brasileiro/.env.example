# Porta da API (padrão 4000)
PORT=4000

# Segredo de assinatura/verificação do JWT (tokens expiram em 48h)
# Gere um valor forte, ex.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=troque-por-uma-chave-secreta-forte

# Chave do TMDB (https://www.themoviedb.org/settings/api)
# Aceita API Key v3 (32 caracteres hex) OU Read Access Token v4 (JWT que começa com "eyJ")
# O service detecta o formato e envia em ?api_key= ou no header Bearer automaticamente.
TMDB_API_TOKEN=sua-chave-do-tmdb

# Credenciais do MongoDB Atlas (cluster criado em https://cloud.mongodb.com)
# Lembre de liberar o IP da máquina no Network Access do cluster.
MONGODB_USERNAME=usuario-do-atlas
MONGODB_PASSWORD=senha-do-atlas
MONGODB_CLUSTER=cluster.exemplo.mongodb.net
MONGODB_DATABASE=arquivo_criminal_brasileiro

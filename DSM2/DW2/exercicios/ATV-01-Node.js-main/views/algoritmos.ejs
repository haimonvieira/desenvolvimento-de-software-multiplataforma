<%- include('partials/header.ejs')%>

<section class="container my-5">

    <div class="container my-5">

        <h1>Algoritmos<span class="azul">.</span></h1>
        <p class="space-grotesk" style="text-transform: uppercase;">introdução</p>
        <p class="mt-3" style="width: 450px;">Uma taxonomia abrangente de primitivas criptográficas modernas. Desde trocas assimétricas resistentes a ataques quânticos até cifras de bloco simétricas de alto desempenho, explore a arquitetura da segurança digital moderna.</p>

    </div>

    <div class="table-responsive">

        <table class="table table-dark space-grotesk">
            <tr style="text-transform: uppercase;" class="table-dark">
                <th><p>Nome do algoritmo</p></th>
                <th><p>Tipo</p></th>
                <th><p>Tamanho da chave</p></th>
                <th><p>Nível de segurança</p></th>
            </tr>
            <% algoritmos.forEach(function(algoritmo){ %>
                <tr>
                <td>
                   <p class="fw-bold text-white"><%= algoritmo.nome %></p>
                </td> 
                <td class="w-25">
                    <p style="text-transform: uppercase; font-weight: bold;" class="bg-secondary text-white text-center border-0"><%= algoritmo.tipo %></p>
                </td>
                <td>
                    <p class="azul"><%= algoritmo.tamanho_chave %></p>
                </td> 
                <td style="text-transform: uppercase; text-align: center; font-weight: bold; width: 25%;">
                    <p class="bg-info bg-opacity-10 rounded azul"><%= algoritmo.nivel_seguranca %></p>
                </td> 
                </tr>
            <% }) %>
            
        </table>
    </div>
</section>


<%- include('partials/footer.ejs')%>

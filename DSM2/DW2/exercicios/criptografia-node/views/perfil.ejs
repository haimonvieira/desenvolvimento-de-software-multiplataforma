<%- include('partials/header.ejs')%>

<section class="container-fluid perfil">
  <div class="container my-5">
    <div class="d-flex flex-column my-5 align-items-start gap-2">
      <h1 class="space-grotesk">Perfil<span class="azul">.</span></h1>
      <p class="mt-3" style="width: 45%">
        Bem-vindo ao seu perfil! Aqui você pode acessar e gerenciar suas
        informações pessoais, visualizar seu histórico de atividades e ajustar
        suas preferências. Mantenha seus dados atualizados para uma experiência
        personalizada e segura.
      </p>
    </div>

    <!-- CONFIGURACAO DE SEGURANCA -->
    <form action="/perfil/<%= perfil.id%>" method="post" class="d-flex flex-column bg-dark p-5 my-5 align-items-start gap-4">
      <div class="d-flex align-items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" height="40px" viewBox="0 -960 960 960" width="40px" fill="#00e5ff">
          <path d="m382-80-18.67-126.67q-17-6.33-34.83-16.66-17.83-10.34-32.17-21.67L178-192.33 79.33-365l106.34-78.67q-1.67-8.33-2-18.16-.34-9.84-.34-18.17 0-8.33.34-18.17.33-9.83 2-18.16L79.33-595 178-767.67 296.33-715q14.34-11.33 32.34-21.67 18-10.33 34.66-16L382-880h196l18.67 126.67q17 6.33 35.16 16.33 18.17 10 31.84 22L782-767.67 880.67-595l-106.34 77.33q1.67 9 2 18.84.34 9.83.34 18.83 0 9-.34 18.5Q776-452 774-443l106.33 78-98.66 172.67-118-52.67q-14.34 11.33-32 22-17.67 10.67-35 16.33L578-80H382Zm55.33-66.67h85l14-110q32.34-8 60.84-24.5T649-321l103.67 44.33 39.66-70.66L701-415q4.33-16 6.67-32.17Q710-463.33 710-480q0-16.67-2-32.83-2-16.17-7-32.17l91.33-67.67-39.66-70.66L649-638.67q-22.67-25-50.83-41.83-28.17-16.83-61.84-22.83l-13.66-110h-85l-14 110q-33 7.33-61.5 23.83T311-639l-103.67-44.33-39.66 70.66L259-545.33Q254.67-529 252.33-513 250-497 250-480q0 16.67 2.33 32.67 2.34 16 6.67 32.33l-91.33 67.67 39.66 70.66L311-321.33q23.33 23.66 51.83 40.16 28.5 16.5 60.84 24.5l13.66 110Zm43.34-200q55.33 0 94.33-39T614-480q0-55.33-39-94.33t-94.33-39q-55.67 0-94.5 39-38.84 39-38.84 94.33t38.84 94.33q38.83 39 94.5 39ZM480-480Z" />
        </svg>
        <h2 class="space-grotesk">Configuração de Segurança</h2>
      </div>

      <div class="d-flex flex-wrap gap-4">
        <div class="card bg-black" style="width: 18rem">
          <div class="card-body">
            <div class="d-flex align-items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#00e5ff">
                <path d="M367-527q-47-47-47-113t47-113q47-47 113-47t113 47q47 47 47 113t-47 113q-47 47-113 47t-113-47ZM160-160v-112q0-34 17.5-62.5T224-378q62-31 126-46.5T480-440q66 0 130 15.5T736-378q29 15 46.5 43.5T800-272v112H160Zm80-80h480v-32q0-11-5.5-20T700-306q-54-27-109-40.5T480-360q-56 0-111 13.5T260-306q-9 5-14.5 14t-5.5 20v32Zm296.5-343.5Q560-607 560-640t-23.5-56.5Q513-720 480-720t-56.5 23.5Q400-673 400-640t23.5 56.5Q447-560 480-560t56.5-23.5ZM480-640Zm0 400Z" />
              </svg>
              <label style="text-transform: uppercase" class="card-title space-grotesk text-white">
                Codinome Publico
              </label>
            </div>
            <br />
            <input style="color: white" value="<%= perfil.codinome%>" type="text" name="codinome" class="card-text bg-dark p-3 space-grotesk" />
          </div>
        </div>
        <div class="card bg-black" style="width: max-content">
          <div class="card-body">
            <div class="d-flex align-items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#00e5ff">
                <path d="M480-80q-83 0-156-31.5T197-197q-54-54-85.5-127T80-480q0-83 31.5-156T197-763q54-54 127-85.5T480-880q83 0 156 31.5T763-763q54 54 85.5 127T880-480v58q0 59-40.5 100.5T740-280q-35 0-66-15t-52-43q-29 29-65.5 43.5T480-280q-83 0-141.5-58.5T280-480q0-83 58.5-141.5T480-680q83 0 141.5 58.5T680-480v58q0 26 17 44t43 18q26 0 43-18t17-44v-58q0-134-93-227t-227-93q-134 0-227 93t-93 227q0 134 93 227t227 93h200v80H480Zm85-315q35-35 35-85t-35-85q-35-35-85-35t-85 35q-35 35-35 85t35 85q35 35 85 35t85-35Z" />
              </svg>
              <label style="text-transform: uppercase" class="card-title space-grotesk text-white">
                nó conectado
              </label>
            </div>

            <br />
            <input value="<%= perfil.no_conectado%>" style="color: white" type="text" name="no_conectado" style="width: max-content" class="card-text bg-dark p-3 space-grotesk" />
          </div>
        </div>
      </div>

      <div class="d-flex gap-4 w-100 justify-content-end mt-4">
        <a href="/" style="text-transform: uppercase" class="btn btn-dark border border-light-subtle p-3 fw-bold space-grotesk">
          encerrar sessão
        </a>
        <button type="submit" style="text-transform: uppercase" class="btn bg-info bg-opacity-75 bg-gradient p-3 fw-bold space-grotesk">
          salvar alterações
        </button>
      </div>
    </form>

    <div action="" class="d-flex flex-column bg-dark p-5 my-5 align-items-start gap-4">
      <div class="d-flex align-items-center gap-2">
        <h2 class="space-grotesk">Ações</h2>
      </div>

      <div>
        <ul>
          <li>
            <a style="text-transform: uppercase" class="btn bg-info bg-opacity-75 bg-gradient space-grotesk" href="/algoritmos/gerenciar">gerenciar algoritmos</a>
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>

<%- include('partials/footer.ejs')%>
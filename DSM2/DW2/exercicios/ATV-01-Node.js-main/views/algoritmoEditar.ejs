<%- include('partials/header.ejs')%>

<section class="container-fluid perfil">
  <div class="container my-5">
    <!-- Título -->
    <div class="d-flex flex-column my-5 align-items-start gap-2">
      <h1 class="space-grotesk">Editar Algoritmo<span class="azul">.</span></h1>
      <p class="mt-3" style="width: 45%">
        Atualize as informações do algoritmo selecionado.
      </p>
    </div>

    <!-- FORM -->
    <form
      action="/algoritmos/alterar"
      method="POST"
      class="d-flex flex-column bg-dark p-5 my-5 align-items-start gap-4"
    >
      <div class="d-flex flex-wrap gap-4">
        <!-- Nome -->
        <div class="card bg-black" style="width: 18rem">
          <div class="card-body">
            <label class="card-title space-grotesk text-white"> Nome </label>
            <input
              type="text"
              name="nome"
              value="<%= algoritmo.nome %>"
              class="card-text bg-dark p-3 space-grotesk w-100 border-0"
              style="color: white"
              required
            />
          </div>
        </div>

        <!-- Tipo -->
        <div class="card bg-black" style="width: 18rem">
          <div class="card-body">
            <label class="card-title space-grotesk text-white"> Tipo </label>
            <input
              type="text"
              name="tipo"
              value="<%= algoritmo.tipo %>"
              class="card-text bg-dark p-3 space-grotesk w-100 border-0"
              style="color: white"
              required
            />
          </div>
        </div>

        <!-- Tamanho -->
        <div class="card bg-black" style="width: 18rem">
          <div class="card-body">
            <label class="card-title space-grotesk text-white">
              Tamanho da chave
            </label>
            <input
              type="text"
              name="tamanhoChave"
              value="<%= algoritmo.tamanho_chave %>"
              class="card-text bg-dark p-3 space-grotesk w-100 border-0"
              style="color: white"
              required
            />
          </div>
        </div>

        <!-- Segurança -->
        <div class="card bg-black" style="width: 18rem">
          <div class="card-body">
            <label class="card-title space-grotesk text-white">
              Nível de segurança
            </label>
            <input
              type="text"
              name="nivelSeguranca"
              value="<%= algoritmo.nivel_seguranca %>"
              class="card-text bg-dark p-3 space-grotesk w-100 border-0"
              style="color: white"
              required
            />
          </div>
        </div>

        <!-- Ano -->
        <div class="card bg-black" style="width: 18rem">
          <div class="card-body">
            <label class="card-title space-grotesk text-white">
              Ano de criação
            </label>
            <input
              type="number"
              name="anoCriacao"
              value="<%= algoritmo.ano_criacao %>"
              class="card-text bg-dark p-3 space-grotesk w-100 border-0"
              style="color: white"
              required
            />
          </div>
        </div>

        <div class="card bg-black" style="width: 18rem">
          <div class="card-body">
            <label class="card-title space-grotesk text-white"> Criador </label>
            <select name="clienteId" required class="form-control">
              <option value="" <%= !algoritmo.criador ? 'selected' : ''%> disabled>Selecione um criador</option>
                <% criadores.forEach(criador => { %>
                  <option value="<%= criador.id%>" <%= criador.id == algoritmo.criador.id ? 'selected' : ''%>><%= criador.nome%></option>
                <%})%>
            </select>
          </div>
        </div>
      </div>

      <!-- ID escondido -->
      <input type="hidden" name="id" value="<%= algoritmo.id %>" />

      <!-- BOTÕES -->
      <div class="d-flex gap-4 w-100 justify-content-end mt-4">
        <button
          type="reset"
          class="btn btn-dark border border-light-subtle p-3 fw-bold space-grotesk"
        >
          Limpar
        </button>

        <button
          type="submit"
          class="btn bg-info bg-opacity-75 bg-gradient p-3 fw-bold space-grotesk"
        >
          Salvar Alterações
        </button>
      </div>
    </form>
  </div>
</section>

<%- include('partials/footer.ejs')%>

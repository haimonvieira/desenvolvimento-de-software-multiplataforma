<%- include('partials/header.ejs')%>

<section class="container-fluid perfil">
  <div class="container my-5">

    <div class="d-flex flex-column my-5 align-items-start gap-2">
      <h1 class="space-grotesk">
        Gerenciar Algoritmos<span class="azul">.</span>
      </h1>
      <p class="mt-3" style="width: 45%">
        Cadastre, visualize, edite e remova algoritmos de criptografia do sistema.
      </p>
    </div>

    <!-- CADASTRAR ALGORITMO -->
    <div class="d-flex flex-column bg-dark p-5 my-5 align-items-start gap-4">
      <div class="d-flex align-items-center gap-2">
        <h2 class="space-grotesk text-white">Cadastrar Algoritmo</h2>
      </div>

      <form action="/algoritmos/cadastrar" method="POST" class="w-100">
        <div class="d-flex flex-wrap gap-4">

          <div class="card bg-black" style="width: 18rem">
            <div class="card-body">
              <label class="card-title space-grotesk text-white" style="text-transform: uppercase">
                Nome
              </label>
              <input type="text" name="nome" placeholder="Ex: AES" class="card-text bg-dark p-3 space-grotesk w-100 border-0" style="color: white" required />
            </div>
          </div>

          <div class="card bg-black" style="width: 18rem">
            <div class="card-body">
              <label class="card-title space-grotesk text-white" style="text-transform: uppercase">
                Tipo
              </label>
              <input type="text" name="tipo" placeholder="Ex: Criptografia simétrica" class="card-text bg-dark p-3 space-grotesk w-100 border-0" style="color: white" required />
            </div>
          </div>

          <div class="card bg-black" style="width: 18rem">
            <div class="card-body">
              <label class="card-title space-grotesk text-white" style="text-transform: uppercase">
                Tamanho da chave
              </label>
              <input type="text" name="tamanhoChave" placeholder="Ex: 256 bits" class="card-text bg-dark p-3 space-grotesk w-100 border-0" style="color: white" required />
            </div>
          </div>

          <div class="card bg-black" style="width: 18rem">
            <div class="card-body">
              <label class="card-title space-grotesk text-white" style="text-transform: uppercase">
                Nível de segurança
              </label>
              <input type="text" name="nivelSeguranca" placeholder="Ex: Alto" class="card-text bg-dark p-3 space-grotesk w-100 border-0" style="color: white" required />
            </div>
          </div>

          <div class="card bg-black" style="width: 18rem">
            <div class="card-body">
              <label class="card-title space-grotesk text-white" style="text-transform: uppercase">
                Ano de criação
              </label>
              <input type="number" name="anoCriacao" placeholder="Ex: 2001" class="card-text bg-dark p-3 space-grotesk w-100 border-0" style="color: white" min="1900" max="2100" required />
            </div>
          </div>

          <div class="card bg-black" style="width: 18rem;">
            <div class="card-body">
              <label class="card-title space-grotesk text-white" style="text-transform: uppercase">
                Criador
              </label>
              <select name="criadorId" required class="form-control">
                <option value="" selected disabled>Selecione um criador</option>
                <% criadores.forEach(criador => { %>
                <option value="<%= criador.id%>"><%= criador.nome%></option>
                <% }) %>
              </select>
            </div>
          </div>
        </div>

        <div class="d-flex gap-4 w-100 justify-content-end mt-4">
          <button type="reset" class="btn btn-dark border border-light-subtle p-3 fw-bold space-grotesk" style="text-transform: uppercase">
            Limpar
          </button>

          <button type="submit" class="btn bg-info bg-opacity-75 bg-gradient p-3 fw-bold space-grotesk" style="text-transform: uppercase">
            Cadastrar
          </button>
        </div>
      </form>
    </div>

    <!-- LISTAR ALGORITMOS -->
    <div class="d-flex flex-column bg-dark p-5 my-5 align-items-start gap-4">
      <div class="d-flex align-items-center gap-2">
        <h2 class="space-grotesk text-white">Algoritmos</h2>
      </div>

      <div class="table-responsive w-100">
        <table class="table table-dark table-striped table-hover align-middle space-grotesk">
          <thead>
            <tr>
              <th>Nome</th>
              <th>Tipo</th>
              <th>Tamanho da chave</th>
              <th>Nível de segurança</th>
              <th>Ano de criação</th>
              <th>Criador</th>
              <th colspan="2" class="text-center">Ações</th>
            </tr>
          </thead>

          <tbody>
            <% algoritmos.forEach(algoritmo => { %>
            <tr>
              <td><%= algoritmo.nome %></td>
              <td><%= algoritmo.tipo %></td>
              <td><%= algoritmo.tamanho_chave %></td>
              <td><%= algoritmo.nivel_seguranca %></td>
              <td><%= algoritmo.ano_criacao %></td>
              <td><%= algoritmo.criador.nome%></td>

              <td class="text-center">
                <a href="/algoritmos/editar/<%= algoritmo.id %>" class="btn btn-warning fw-bold">
                  Editar
                </a>
              </td>

              <td class="text-center">
                <a href="/algoritmos/excluir/<%= algoritmo.id %>">
                  <button onclick="return confirm('Deseja mesmo excluir o algoritmo <%= algoritmo.nome %>?')" class="btn btn-danger fw-bold">
                    Excluir
                  </button>
                </a>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>

  </div>
</section>

<%- include('partials/footer.ejs')%>
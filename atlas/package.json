{
  "name": "dsm-atlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "catalog:build": "node --experimental-strip-types scripts/build-catalog.ts",
    "predev": "node --experimental-strip-types scripts/build-catalog.ts",
    "dev": "vite dev",
    "prebuild": "node --experimental-strip-types scripts/build-catalog.ts",
    "build": "vite build",
    "preview": "wrangler dev --config dist/server/wrangler.json",
    "deploy": "vinext-cloudflare deploy --config dist/server/wrangler.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "pretest:e2e": "node --experimental-strip-types scripts/build-catalog.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.1.0",
    "@vinext/cloudflare": "1.0.0-beta.11",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-server-dom-webpack": "19.3.0",
    "vinext": "1.0.0-beta.13",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.61.0",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.35",
    "eslint": "9.38.0",
    "eslint-config-next": "16.3.6",
    "fake-indexeddb": "^6.2.5",
    "typescript": "6.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2",
    "wrangler": "4.142.0"
  }
}

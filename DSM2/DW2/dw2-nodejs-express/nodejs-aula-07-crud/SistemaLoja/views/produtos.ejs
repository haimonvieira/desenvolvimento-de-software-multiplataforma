<%- include ('partials/header.ejs') %>
<%- include ('partials/navbar.ejs') %>

    <!-- Formulário de cadastro -->
        <div class="container">
            <div class="card">
                <div class="card-header">
                    <h1>Cadastrar Produto</h1>
                </div>
                <div class="card-body">
                    <form method="post" action="/produtos/cadastrar">
                        <label for="nome">Produto:</label>
                        <input class="form-control" type="text" name="produto" placeholder="Insira o nome do produto" required>

                        <label for="nome">Preço:</label>
                        <input class="form-control" maxlength="12" type="text" name="preco" placeholder="Insira o preço do produto" required>

                        <label for="nome">Categoria:</label>
                        <input class="form-control" type="text" name="categoria" placeholder="Insira a categoria do produto" required>

                        <br>

                        <button class="btn btn-success" type="submit">Cadastrar Produto</button>
                        <button class="btn btn-warning" type="reset">Limpar</button>

                    </form>
                </div>
            </div>

            <hr>

        </div>

    <div class="container">
        <div class="card">
            <div class="card-header">
                <h1>Produtos</h1>
            </div>
            <div class="card-body">
                <table>
                    <thead>
                        <tr>
                            <th></th>
                            <th>Nome:</th>
                            <th>Preço:</th>
                            <th>Categoria:</th>
                            <th colspan="2" style="text-align: center;">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% produtos.forEach(produto => { %>
                        <tr>
                            <td><img src="imgs/product.png" width="30px"></td>
                            <td><%= produto.nome %></td>
                            <td><%= produto.preco.toLocaleString('pt-br', {style: 'currency', currency: 'BRL'}) %></td>
                            <td><%= produto.categoria %></td>
                            <td>
                                <a href="/produtos/excluir/<%= produto.id%>">
                                    <button onclick="return confirm('Tem certeza que deseja excluir o produto <%= produto.nome%>?')" class="btn btn-danger">Excluir</button>
                                </a>
                            </td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

<%- include ('partials/footer.ejs') %>
